{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "customManagers": [
      {
        "customType": "regex",
        "description": "Versions d'outils épinglées dans les workflows via un commentaire `# renovate:`",
        "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
        "matchStrings": [
          "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)"
        ]
      }
    ],
    "packageRules": [
      {
        "matchManagers": ["helm-values"],
        "matchDatasources": ["docker"],
        "enabled": true,
        "automerge": true,
        "automergeType": "branch",
        "matchUpdateTypes": ["patch"],
        "prCreation": "immediate",
        "bumpVersion": "patch"
      },
      {
        "matchManagers": ["helm-values"],
        "matchDatasources": ["docker"],
        "enabled": true,
        "automerge": false,
        "matchUpdateTypes": ["minor", "major"],
        "prCreation": "immediate"
      },
      {
        "matchManagers": ["helmv3"],
        "matchDatasources": ["helm"],
        "enabled": true,
        "automerge": false,
        "prCreation": "immediate"
      },
      {
        "description": "Action Renovate elle-même : automerge des mises à jour patch et mineures, major reste manuel",
        "matchManagers": ["github-actions"],
        "matchPackageNames": ["renovatebot/github-action"],
        "enabled": true,
        "automerge": true,
        "automergeType": "branch",
        "matchUpdateTypes": ["minor", "patch"],
        "prCreation": "immediate",
        "ignoreTests": true
      }
    ]
  }
