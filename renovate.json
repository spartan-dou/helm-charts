{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "packageRules": [
      {
        "matchManagers": ["helm-values"],
        "matchDatasources": ["docker"],
        "enabled": true,
        "automerge": true,
        "automergeType": "branch",
        "matchUpdateTypes": ["patch"],
        "prCreation": "immediate",
        "bumpVersion": "patch",
        "ignoreTests": true
      },
      {
        "matchManagers": ["helm-values"],
        "matchDatasources": ["docker"],
        "enabled": true,
        "automerge": false,
        "matchUpdateTypes": ["minor", "major"],
        "prCreation": "immediate",
        "ignoreTests": true
      },
      {
        "matchManagers": ["helmv3"],
        "matchDatasources": ["helm"],
        "enabled": true,
        "automerge": false,
        "prCreation": "immediate",
        "ignoreTests": true
      },
      {
        "description": "L'image Sunshine est publiée quasi quotidiennement (CalVer) : automerge des mises à jour patch et mineures, major reste manuel",
        "matchManagers": ["dockerfile"],
        "matchDatasources": ["docker"],
        "matchPackageNames": ["lizardbyte/sunshine"],
        "enabled": true,
        "automerge": true,
        "automergeType": "branch",
        "matchUpdateTypes": ["minor", "patch"],
        "prCreation": "immediate",
        "ignoreTests": true
      },
      {
        "description": "Action Renovate elle-même : automerge des mises à jour patch et mineures, major reste manuel",
        "matchManagers": ["github-actions"],
        "matchPackageNames": ["renovatebot/github-action"],
        "enabled": true,
        "automerge": true,
        "automergeType": "branch",
        "matchUpdateTypes": ["minor", "patch"],
        "prCreation": "immediate",
        "ignoreTests": true
      }
    ]
  }
